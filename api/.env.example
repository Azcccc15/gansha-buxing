# DeepSeek 平台创建的密钥，只保存在服务端。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=60000

# 默认仅本机访问。安卓模拟器访问电脑可使用 10.0.2.2:8787。
HOST=127.0.0.1
PORT=8787

# 局域网真机访问：HOST=0.0.0.0，同时设置至少 32 字符的接口口令。
# 接口口令与 DeepSeek 密钥不同，不要把 DeepSeek 密钥放进安装包。
APP_API_TOKEN=

# 浏览器跨域调用时填写完整来源，逗号分隔；安卓原生调用无需设置。
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_REQUESTS=2
